			{ id = "st2", name = "Thunderhead", u = 7, cd = 12, cost = 32, kind = "rain", n = 8, area = 25, rad = 8, dmg = 3, interval = 0.15, status = { "stun", 0.5 }, desc = "Lightning strikes rain down around your aim." },
