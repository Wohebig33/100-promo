			{ id = "um2", name = "Night Veil", u = 7, cd = 13, cost = 30, kind = "nova", at = "self", rad = 23, dmg = 3, heal = 0.15, status = { "slow", 2 }, desc = "Shadow bursts from you, healing 15% HP." },
