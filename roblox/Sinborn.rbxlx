			{ id = "fr2", name = "Frozen Tomb", u = 7, cd = 12, cost = 30, kind = "nova", at = "cursor", rad = 17, delay = 0.4, dmg = 3.5, status = { "stun", 2.2 }, desc = "Encase an area in ice, freezing enemies solid." },
