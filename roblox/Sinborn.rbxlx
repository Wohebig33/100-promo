			{ id = "br2", name = "Fissure", u = 7, cd = 11, cost = 28, kind = "beam", len = 50, width = 7.7, delay = 0.35, dmg = 4.2, status = { "root", 1.8 }, desc = "Split the ground in a line, rooting enemies." },
